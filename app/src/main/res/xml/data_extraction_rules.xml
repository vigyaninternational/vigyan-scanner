<?xml version="1.0" encoding="utf-8"?>
<!-- Admission scans (Aadhaar, certificates) and the app lock stay on this phone: nothing goes to
     Google's cloud backup or a phone-to-phone copy. The app's own Backup button (a zip you keep) is the way to move scans. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
